# ── Database (Neon Postgres) ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Login ────────────────────────────────────────────────────────────
# Type either company's name (e.g. "Sri Lalithha Pulverisers" or "Renuka")
# with this password. Switch companies inside the app.
APP_PASSWORD="1234"                 # 4 digits — change this!
AUTH_SECRET="any-long-random-text"  # signs the login cookie

# ── Gemini (bill reading) ────────────────────────────────────────────
GEMINI_API_KEYS="key1,key2"
# Free tier = 20 reads per model per day per Google project.
# If your keys come from N different Google Cloud projects, set N here.
GEMINI_PROJECTS=1

# ── Google Sheets: one per company ───────────────────────────────────
# Web app URL from deploying google-apps-script/Code.gs in each sheet.
GOOGLE_SHEETS_WEBHOOK_URL_SLP="https://script.google.com/macros/s/XXXX/exec"
GOOGLE_SHEETS_WEBHOOK_URL_RENUKA="https://script.google.com/macros/s/YYYY/exec"
# Links to open each sheet from the app
GOOGLE_SHEET_URL_SLP="https://docs.google.com/spreadsheets/d/XXXX/edit"
GOOGLE_SHEET_URL_RENUKA="https://docs.google.com/spreadsheets/d/YYYY/edit"
# Optional shared secret; must match TOKEN in Code.gs
SHEETS_TOKEN=""
