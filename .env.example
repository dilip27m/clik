# PostgreSQL Connection URL (Running in Docker via docker-compose on port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/transit_db?schema=public"

# Gemini API Key for Vision extraction (Optional: can also be configured via Web UI Settings)
GEMINI_API_KEY=""

# Port for Next.js app (defaults to 3001 if 3000 is used)
PORT=3001
