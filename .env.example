# ── Database (Neon Postgres) ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Login ────────────────────────────────────────────────────────────
APP_COMPANY_NAME="Sri Lalithha Pulverisers"
APP_PASSWORD="1234"                 # 4 digits — change this!
AUTH_SECRET="any-long-random-text"  # signs the login cookie

# ── Gemini (bill reading) ────────────────────────────────────────────
GEMINI_API_KEYS="key1,key2"
# Free tier = 20 reads per model per day per Google project.
# If your keys come from N different Google Cloud projects, set N here.
GEMINI_PROJECTS=1
# Optional: override the model order
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite"

# ── Google Sheet + Drive photos ──────────────────────────────────────
# Web app URL from deploying google-apps-script/Code.gs
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXX/exec"
# Optional shared secret; must match TOKEN in Code.gs
SHEETS_TOKEN=""
# Link to open the sheet from the app
NEXT_PUBLIC_GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/XXXX/edit"
